{
  "manifest_version": 3,
  "name": "Verity",
  "version": "1.0.0",
  "description": "Warns you when a website looks like a copy of a well-known one and shows you the real address. Checks run on your device.",
  "minimum_chrome_version": "110",
  "permissions": [
    "webNavigation",
    "storage",
    "activeTab",
    "alarms"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Verity",
    "default_popup": "pages/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "pages/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"
  },
  "optional_host_permissions": [
    "https://tranco-list.eu/*",
    "https://phishunt.io/*",
    "https://ublockorigin.github.io/*",
    "https://curbengh.github.io/*",
    "https://raw.githubusercontent.com/*"
  ]
}
